# Copy to .env and adjust. NEVER commit .env.
# Local dev defaults (trust auth, localhost-only) work out of the box.

# Business database (the AgentScope runtime uses its own "agentscope" db)
PLATFORM_DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/platform

# JWT signing secret for platform auth
PLATFORM_JWT_SECRET=change-me

# AgentScope runtime (only used by app/runtime_client, not imported here)
PLATFORM_RUNTIME_BASE_URL=http://localhost:8000
