# Copy to .env and fill in real values:
#   cp .env.example .env

# Company PostgreSQL (sync URL is OK; main.py rewrites to +asyncpg)
AGENTSCOPE_PG_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# Local Redis for AgentScope (dedicated Docker container on 6380).
# Do NOT use 6379 if Langfuse/other stacks already occupy it with AUTH.
AGENTSCOPE_REDIS_HOST=127.0.0.1
AGENTSCOPE_REDIS_PORT=6380

# Service bind
AGENTSCOPE_HOST=0.0.0.0
AGENTSCOPE_PORT=8000

# ChatLing — used by curl examples + eval_timeout_retry.py (not by main.py)
CHATLING_API_KEY=your_api_key_here
CHATLING_BASE_URL=https://chatgpt.58corp.com/api/v2
CHATLING_MODEL=chatling-plus
CHATLING_FALLBACK_MODEL=chatling-turbo-0729

# Tavily web search, seeded into every workspace as a default MCP.
# Free tier: 1000 credits/month, no card. Leave empty to run without search.
# Get a key at https://app.tavily.com
TAVILY_API_KEY=

# Admin / ops account holding the pre-built agents + model credential.
# Every other user sees them read-only under "Shared with you" and can
# chat right away, while their sessions stay private. Leave empty for
# the framework default, where each user builds their own agents.
AGENTSCOPE_ADMIN_USER_ID=
